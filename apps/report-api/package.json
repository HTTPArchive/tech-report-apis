{
  "name": "report-api",
  "version": "1.0.0",
  "description": "API for HTTP Archive reports",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "function": "DATABASE=tech-report-api-prod IGNORED_ROUTES= functions-framework --target=app",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:live": "bash ../../scripts/test-api.sh",
    "build": "docker build -t report-api -f apps/report-api/Dockerfile .",
    "lint": "eslint .",
    "docker": "docker run -p 8080:8080 report-api"
  },
  "dependencies": {
    "@google-cloud/bigquery": "9.5.0",
    "@google-cloud/firestore": "9.4.0",
    "@google-cloud/functions-framework": "5.0.5",
    "@google-cloud/storage": "8.4.0",
    "@httparchive/shared": "*",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@httparchive/eslint-config": "*",
    "@httparchive/jest-config": "*",
    "@jest/transform": "30.5.2",
    "eslint": "^10.13.0",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  }
}

